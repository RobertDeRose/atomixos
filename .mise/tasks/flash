#!/usr/bin/env bash
#MISE description="Flash image to disk device (eMMC/SD) using dd with progress"
#USAGE flag "-y --yes" help="Skip confirmation prompt"
#USAGE flag "-i --image <path>" help="Path to image file (default: .gcroots/<board>/current/image)"
#USAGE flag "--board <board>" help="Board whose latest build to flash (required with several builds and no --image)" {
#USAGE   choices "rock64" "cm3"
#USAGE }
#USAGE arg "[disk]" help="Target disk device (e.g. /dev/disk4 on macOS, /dev/mmcblk0 on Linux)"
set -euo pipefail

board_image() {
	local candidate
	for candidate in ".gcroots/$1/current/image"/*.img; do
		if [ -f "$candidate" ]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done
	return 1
}

# ── Resolve image path ─────────────────────────────────────────────────────────
# Never guess the board: a ROCK64 image on a CM3 eMMC (or the reverse) writes the
# wrong bootloader. Without --image or --board, use the only board with a build.

BOARD=${usage_board:-}
IMAGE_PATH="${usage_image:-}"
if [ -z "$IMAGE_PATH" ]; then
	if [ -z "$BOARD" ]; then
		built=()
		for candidate_board in rock64 cm3; do
			if board_image "$candidate_board" >/dev/null; then
				built+=("$candidate_board")
			fi
		done
		if [ ${#built[@]} -ne 1 ]; then
			echo "ERROR: choose a board with --board rock64|cm3, or pass --image <path>." >&2
			if [ ${#built[@]} -gt 1 ]; then
				echo "Builds exist for: ${built[*]}" >&2
			else
				echo "No build found; run 'mise run build --board <board>' first." >&2
			fi
			exit 1
		fi
		BOARD=${built[0]}
		echo "Using the only built board: $BOARD"
	fi
	case "$BOARD" in
	rock64 | cm3) ;;
	*)
		echo "ERROR: unsupported board '$BOARD' (expected rock64 or cm3)" >&2
		exit 1
		;;
	esac
	IMAGE_PATH=$(board_image "$BOARD" || true)
fi

if [ -z "$IMAGE_PATH" ] || [ ! -f "$IMAGE_PATH" ]; then
	echo "ERROR: No image file found."
	echo ""
	echo "Either:"
	echo "  1. Run 'mise run build --board ${BOARD:-<board>}' to build the selected board image"
	echo "  2. Specify the image path: mise run flash --image /path/to/image.img /dev/diskN"
	exit 1
fi

IMAGE_SIZE=$(stat -c%s "$IMAGE_PATH" 2>/dev/null || stat -f%z "$IMAGE_PATH")
IMAGE_SIZE_MIB=$((IMAGE_SIZE / 1024 / 1024))

# ── Resolve target disk ────────────────────────────────────────────────────────

DISK="${usage_disk:-}"
SKIP_CONFIRM="${usage_yes:-false}"
OS=$(uname -s)

select_macos_disk() {
	local external_disks selection index line disk desc
	external_disks=()
	while IFS= read -r line; do
		external_disks+=("$line")
	done < <(diskutil list external | awk '/^\/dev\/disk/ { disk=$1 } /^ *0:/ { printf "%s %s %s %s\n", disk, $3, $4, $5 }')

	if [ ${#external_disks[@]} -eq 0 ]; then
		echo "ERROR: No external disks found." >&2
		echo "" >&2
		echo "Connect the eMMC USB adapter and try again, or specify a disk explicitly." >&2
		exit 1
	fi

	if [ ${#external_disks[@]} -eq 1 ]; then
		printf '%s\n' "${external_disks[0]%% *}"
		return
	fi

	echo "Multiple external disks found:" >&2
	for index in "${!external_disks[@]}"; do
		line="${external_disks[$index]}"
		disk="${line%% *}"
		desc="${line#* }"
		printf '  %d) %s %s\n' "$((index + 1))" "$disk" "$desc" >&2
	done
	echo "" >&2

	while true; do
		read -rp "Select disk number: " selection >&2
		if [[ "$selection" =~ ^[0-9]+$ ]] && [ "$selection" -ge 1 ] && [ "$selection" -le ${#external_disks[@]} ]; then
			printf '%s\n' "${external_disks[$((selection - 1))]%% *}"
			return
		fi
		echo "Invalid selection. Enter a number from the list." >&2
	done
}

# Removable or USB whole disks, one "NAME TRAN SIZE MODEL" line each. These are
# the only disks flash will write on Linux.
linux_external_disks() {
	lsblk -dpno NAME,TYPE,RM,TRAN,SIZE,MODEL |
		awk '$2 == "disk" && ($3 == "1" || $4 == "usb") {
			model = ""
			for (i = 6; i <= NF; i++) {
				model = model (i == 6 ? "" : " ") $i
			}
			printf "%s %s %s %s\n", $1, $4, $5, model
		}'
}

# Print why a disk is in use and succeed, or fail when it is free. A disk is in
# use when any device on it, or layered on it (LVM, LUKS, RAID), is mounted or
# is swap, or carries a storage-stack signature. lsblk can't map ZFS dataset
# mounts back to pool disks, so a pool member counts even with no mountpoint.
linux_disk_in_use() {
	local mountpoints fstypes fstype
	# MOUNTPOINT, not MOUNTPOINTS: util-linux before 2.37 lacks the plural
	# column, and one mountpoint per device is enough to detect use.
	if ! mountpoints=$(lsblk -nlpo MOUNTPOINT "$1") || ! fstypes=$(lsblk -nlpo FSTYPE "$1"); then
		echo "lsblk cannot inspect it"
		return 0
	fi
	mountpoints=$(printf '%s\n' "$mountpoints" | sed '/^[[:space:]]*$/d' | paste -sd ' ' -)
	if [ -n "$mountpoints" ]; then
		echo "in use at $mountpoints; unmount it (or swapoff) first"
		return 0
	fi
	for fstype in $fstypes; do
		case "$fstype" in
		zfs_member | LVM2_member | linux_raid_member | crypto_LUKS | swap)
			echo "holds a $fstype signature; clear it with 'wipefs -a $1' to flash it"
			return 0
			;;
		esac
	done
	return 1
}

select_linux_disk() {
	local external_disks selection index line disk desc reason
	external_disks=()
	while IFS= read -r line; do
		if reason=$(linux_disk_in_use "${line%% *}"); then
			echo "Skipping ${line%% *}: $reason" >&2
			continue
		fi
		external_disks+=("$line")
	done < <(linux_external_disks)

	if [ ${#external_disks[@]} -eq 0 ]; then
		echo "ERROR: No unused removable or USB disks found." >&2
		echo "" >&2
		echo "Connect the eMMC USB adapter and try again, or specify a disk explicitly." >&2
		exit 1
	fi

	if [ ${#external_disks[@]} -eq 1 ]; then
		printf '%s\n' "${external_disks[0]%% *}"
		return
	fi

	echo "Multiple unused removable or USB disks found:" >&2
	for index in "${!external_disks[@]}"; do
		line="${external_disks[$index]}"
		disk="${line%% *}"
		desc="${line#* }"
		printf '  %d) %s %s\n' "$((index + 1))" "$disk" "$desc" >&2
	done
	echo "" >&2

	while true; do
		read -rp "Select disk number: " selection >&2
		if [[ "$selection" =~ ^[0-9]+$ ]] && [ "$selection" -ge 1 ] && [ "$selection" -le ${#external_disks[@]} ]; then
			printf '%s\n' "${external_disks[$((selection - 1))]%% *}"
			return
		fi
		echo "Invalid selection. Enter a number from the list." >&2
	done
}

if [ -z "$DISK" ]; then
	if [ "$OS" = "Darwin" ]; then
		DISK="$(select_macos_disk)"
	else
		DISK="$(select_linux_disk)"
	fi
fi

# On macOS, use the raw device for much faster writes
RAW_DISK="$DISK"
if [ "$OS" = "Darwin" ]; then
	# /dev/disk4 -> /dev/rdisk4 (raw device, bypasses buffer cache)
	RAW_DISK="${DISK/\/dev\/disk//dev/rdisk}"
fi

# ── Validate target ───────────────────────────────────────────────────────────

if [ "$OS" = "Darwin" ]; then
	# macOS: check disk exists via diskutil
	if ! diskutil info "$DISK" &>/dev/null; then
		echo "ERROR: Disk not found: $DISK"
		echo ""
		echo "Available disks:"
		diskutil list | grep -E "^/dev/disk"
		exit 1
	fi

	# Safety: refuse to write to the boot disk
	BOOT_DISK=$(diskutil info / | grep "Device Node" | awk '{print $NF}' | sed 's/s[0-9]*$//')
	if [ "$DISK" = "$BOOT_DISK" ]; then
		echo "ERROR: Refusing to write to boot disk ($BOOT_DISK)"
		exit 1
	fi
else
	# Linux: check block device exists
	if [ ! -b "$DISK" ]; then
		echo "ERROR: Not a block device: $DISK"
		exit 1
	fi

	if ! command -v lsblk >/dev/null; then
		echo "ERROR: lsblk is required to check the target disk"
		exit 1
	fi

	# The image holds a partition table, so the target must be a whole disk.
	if [ "$(lsblk -ndo TYPE "$DISK")" != "disk" ]; then
		echo "ERROR: Not a whole disk: $DISK (pass the disk, not a partition)"
		exit 1
	fi

	# Safety: only write removable or USB disks, the same ones the interactive
	# selection offers. Internal system disks are neither, whatever their
	# filesystems (ZFS, btrfs, LVM, LUKS, RAID).
	target_disk=$(readlink -f "$DISK")
	is_external=false
	while read -r external_disk _; do
		if [ -n "$external_disk" ] && [ "$(readlink -f "$external_disk")" = "$target_disk" ]; then
			is_external=true
		fi
	done < <(linux_external_disks)
	if [ "$is_external" != "true" ]; then
		echo "ERROR: Not a removable or USB disk: $DISK"
		echo "Available removable or USB disks:"
		linux_external_disks | sed 's/^/  /'
		exit 1
	fi

	# Never write a disk anything is using, including the running system's own
	# disk when it boots from USB.
	if reason=$(linux_disk_in_use "$DISK"); then
		echo "ERROR: $DISK is in use: $reason"
		exit 1
	fi
fi

# ── Detect compression ─────────────────────────────────────────────────────────

DECOMPRESS=""
COMPRESS_LABEL=""

detect_compression() {
	case "$1" in
	*.gz | *.gzip)
		DECOMPRESS="gzip -dc"
		COMPRESS_LABEL="gzip"
		;;
	*.xz)
		DECOMPRESS="xz -dc"
		COMPRESS_LABEL="xz"
		;;
	*.zst | *.zstd)
		DECOMPRESS="zstd -dc"
		COMPRESS_LABEL="zstd"
		;;
	*.bz2)
		DECOMPRESS="bzip2 -dc"
		COMPRESS_LABEL="bzip2"
		;;
	*.lz4)
		DECOMPRESS="lz4 -dc"
		COMPRESS_LABEL="lz4"
		;;
	*)
		# Fall back to file(1) magic detection
		local magic
		magic="$(file -b "$1" 2>/dev/null || true)"
		case "$magic" in
		gzip*) DECOMPRESS="gzip -dc" COMPRESS_LABEL="gzip" ;;
		XZ*) DECOMPRESS="xz -dc" COMPRESS_LABEL="xz" ;;
		Zstandard*) DECOMPRESS="zstd -dc" COMPRESS_LABEL="zstd" ;;
		bzip2*) DECOMPRESS="bzip2 -dc" COMPRESS_LABEL="bzip2" ;;
		LZ4*) DECOMPRESS="lz4 -dc" COMPRESS_LABEL="lz4" ;;
		esac
		;;
	esac

	if [ -n "$DECOMPRESS" ]; then
		local tool="${DECOMPRESS%% *}"
		if ! command -v "$tool" &>/dev/null; then
			echo "ERROR: $tool is required to decompress $COMPRESS_LABEL images but was not found on PATH."
			exit 1
		fi
	fi
}

detect_compression "$IMAGE_PATH"

# ── Show info and confirm ─────────────────────────────────────────────────────

echo "=== AtomixOS Flash ==="
echo ""
echo "  Image:  $IMAGE_PATH ($IMAGE_SIZE_MIB MiB$([ -n "$COMPRESS_LABEL" ] && echo ", $COMPRESS_LABEL compressed"))"
echo "  Target: $DISK"
if [ "$OS" = "Darwin" ] && [ "$RAW_DISK" != "$DISK" ]; then
	echo "  Raw:    $RAW_DISK (using raw device for speed)"
fi
echo ""

if [ "$OS" = "Darwin" ]; then
	echo "Target disk info:"
	diskutil list "$DISK" 2>/dev/null || true
	echo ""
fi

if [ "$SKIP_CONFIRM" != "true" ]; then
	echo "WARNING: This will DESTROY all data on $DISK"
	echo ""
	read -rp "Type 'yes' to continue: " CONFIRM
	if [ "$CONFIRM" != "yes" ]; then
		echo "Aborted."
		exit 1
	fi
	echo ""
fi

# ── Unmount partitions ─────────────────────────────────────────────────────────
# Flash never unmounts on Linux. Check the target again right before writing: a
# desktop can automount it while the confirmation prompt waits.

if [ "$OS" = "Darwin" ]; then
	echo "Unmounting partitions on $DISK..."
	diskutil unmountDisk "$DISK" 2>/dev/null || true
elif reason=$(linux_disk_in_use "$DISK"); then
	echo "ERROR: $DISK is in use: $reason"
	exit 1
fi

# ── Flash ──────────────────────────────────────────────────────────────────────

if [ -n "$DECOMPRESS" ]; then
	echo "Decompressing ($COMPRESS_LABEL) and flashing to $RAW_DISK..."
else
	echo "Flashing $IMAGE_SIZE_MIB MiB to $RAW_DISK..."
fi
echo ""

if [ -n "$DECOMPRESS" ]; then
	if [ "$OS" = "Darwin" ]; then
		$DECOMPRESS "$IMAGE_PATH" | sudo dd of="$RAW_DISK" bs=4m status=progress
	else
		$DECOMPRESS "$IMAGE_PATH" | dd of="$RAW_DISK" bs=4M status=progress
	fi
elif [ "$OS" = "Darwin" ]; then
	sudo dd if="$IMAGE_PATH" of="$RAW_DISK" bs=4m status=progress
else
	dd if="$IMAGE_PATH" of="$RAW_DISK" bs=4M status=progress
fi

# ── Sync and eject ─────────────────────────────────────────────────────────────

echo ""
echo "Syncing..."
sync

if [ "$OS" = "Darwin" ]; then
	echo "Ejecting $DISK..."
	diskutil eject "$DISK" 2>/dev/null || true
fi

echo ""
echo "=== Flash complete ==="
echo ""
echo "Image $IMAGE_PATH ($IMAGE_SIZE_MIB MiB) written to $DISK"
echo ""
if [ "$OS" = "Darwin" ]; then
	echo "The disk has been ejected. You can remove the eMMC module."
else
	echo "You can now remove the eMMC module or reboot the device."
fi
