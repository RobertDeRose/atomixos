#!/usr/bin/env bash
#MISE description="Launch interactive QEMU VM for debugging E2E tests"
#USAGE flag "-t --test <name>" help="Test to debug" default="slots"
#USAGE flag "--keep" help="Keep VM state between runs"
#USAGE flag "--lima" help="Run inside a Lima VM"
#USAGE flag "--vm <name>" help="Lima VM instance name" default="default"
set -euo pipefail

case "${usage_test:-slots}" in
slots) check_name=rauc-slots ;;
update) check_name=rauc-update ;;
rollback) check_name=rauc-rollback ;;
confirm) check_name=rauc-confirm ;;
power-loss) check_name=rauc-power-loss ;;
watchdog) check_name=rauc-watchdog ;;
firewall) check_name=firewall ;;
net-iso) check_name=network-isolation ;;
ssh-toggle) check_name=ssh-wan-toggle ;;
*)
	echo "Unknown test: ${usage_test}" >&2
	echo "Available: slots, update, rollback, confirm, power-loss, watchdog, firewall, net-iso, ssh-toggle" >&2
	exit 1
	;;
esac

args=(--interactive)
if [[ "${usage_keep:-false}" == true ]]; then
	args+=(--keep)
fi
exec ./scripts/run-e2e-check.sh "${args[@]}" "$check_name" \
	"Launches the selected NixOS VM test driver for interactive debugging"
