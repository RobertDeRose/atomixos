amends "package://github.com/jdx/hk/releases/download/v1.41.0/hk@1.41.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.41.0/hk@1.41.0#/Builtins.pkl"

local commit_message_validation: Step = new Step {
  check =
    #"""
    perl -0pi -e "s/[ \t]+\$//mg; s/(?<=\S) {2,}/ /g; s/\A([^\n]*\n)\n{2,}(?=.)/$1\n\n/s" {{commit_msg_file}}
    perl -0ne 'BEGIN { $/ = undef } exit 1 if /\A[^\n]*\n\n\n/ || /\A[^\n]*\n[^\n]/' {{commit_msg_file}}
    typos {{commit_msg_file}}
    commitlint --edit {{commit_msg_file}}
    """#
}

local commit_message_beads: Step = new Step {
  check =
    #"""
    awk '
      /^# ------------------------ >8 ------------------------/ { exit }
      /^diff --git / { exit }
      /^#/ { next }
      /^(Refs?|Tasks?|Issues?):/ {
        printf "use the canonical Beads: footer instead of: %s\n", $0 > "/dev/stderr"
        failed = 1
      }
      /^Beads:/ {
        beads += 1
        if ($0 !~ /^Beads: [a-z][a-z0-9-]*-[a-z0-9][a-z0-9.-]*(, [a-z][a-z0-9-]*-[a-z0-9][a-z0-9.-]*)*$/) {
          printf "invalid Beads footer: %s\n", $0 > "/dev/stderr"
          failed = 1
        }
      }
      NF { last = $0 }
      END {
        if (beads > 1) {
          print "commit message must contain at most one Beads: footer" > "/dev/stderr"
          failed = 1
        }
        if (beads == 1 && last !~ /^Beads:/) {
          print "Beads: must be the final nonblank line" > "/dev/stderr"
          failed = 1
        }
        exit failed
      }
    ' {{commit_msg_file}}
    """#
}

local commit_message_length: Step = new Step {
  check =
    #"""
    awk '
      /^# ------------------------ >8 ------------------------/ { exit }
      /^diff --git / { exit }
      /^#/ { next }
      {
        line += 1
        limit = line == 1 ? 72 : 100
        if (length($0) > limit) {
          printf "commit message line %d is %d characters; maximum is %d\n", line, length($0), limit > "/dev/stderr"
          failed = 1
        }
      }
      END { exit failed }
    ' {{commit_msg_file}}
    """#
}

local commit_message_scope: Step = new Step {
  check =
    #"""
    awk '
      /^# ------------------------ >8 ------------------------/ { exit }
      /^diff --git / { exit }
      /^#/ { next }
      NF {
        if ($0 ~ /^(feat|fix|perf|refactor)!?: /) {
          print "changelog-visible commit subject must use type(scope): summary" > "/dev/stderr"
          exit 1
        }
        exit 0
      }
    ' {{commit_msg_file}}
    """#
}

local cocogitto_commit_message: Step = new Step {
  check = "cog --quiet verify --file {{commit_msg_file}}"
}

local harper_commit_message: Step = new Step {
  check =
    #"""
    output=$(mktemp)
    trap 'rm -f "$output"' EXIT
    awk '
      /^# ------------------------ >8 ------------------------/ { exit }
      /^diff --git / { exit }
      /^#/ { next }
      /^Beads: [a-z][a-z0-9-]*-[a-z0-9][a-z0-9.-]*(, [a-z][a-z0-9-]*-[a-z0-9][a-z0-9.-]*)*$/ { next }
      {
        line = $0
        if (!seen_subject && NF) {
          seen_subject = 1
          if (line ~ /^release: v[0-9]+\.[0-9]+\.[0-9]+$/) { next }
          sub(/^[a-z]+(\([^)]+\))?!?: /, "", line)
        }
        print line
      }
    ' {{commit_msg_file}} | harper-cli lint --quiet --no-color --user-dict-path .config/harper-dictionary.txt 2>"$output"
    status=$?
    awk '!/^Note: Using user dictionary at /' "$output" >&2
    exit "$status"
    """#
}

local linters = new Mapping<String, Step> {
  ["actionlint"] = Builtins.actionlint
  ["check_byte_order_marker"] = Builtins.check_byte_order_marker
  ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
  ["check_symlinks"] = Builtins.check_symlinks
  ["check-added-large-files"] = Builtins.check_added_large_files
  ["check-exec-shebangs"] = Builtins.check_executables_have_shebangs
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["detect-private-key"] = (Builtins.detect_private_key) {
    exclude = List("certs/dev.*.key.pem")
  }
  ["deadnix"] = Builtins.deadnix
  ["contextlint"] = new Step {
    glob = List("README.md", "docs/**/*.md", "contextlint.config.json")
    check = "contextlint"
  }
  ["docs"] = new Step {
    glob = List("docs/src/**/*.md", "docs/book.toml", "scripts/check-docs.py")
    check = "uv run scripts/check-docs.py && mdbook build docs"
  }
  ["mise"] = Builtins.mise
  ["mixed-line-ending"] = Builtins.mixed_line_ending
  ["markdown-table-formatter"] = new Step {
    glob = List("**/*.md", "**/*.markdown")
    check_diff = "markdown-table-formatter --check {{ files }}"
    fix = "markdown-table-formatter {{ files }}"
  }
  ["rumdl"] = (Builtins.rumdl) {
    check_diff = "rumdl check --config .config/rumdl.toml --diff {{ files }}"
    fix = "rumdl check --config .config/rumdl.toml --fix {{ files }}"
  }
  ["ruff"] = Builtins.ruff
  ["newlines"] = Builtins.newlines
  ["nixfmt"] = Builtins.nix_fmt
  ["pkl_format"] = Builtins.pkl_format
  ["mktoc"] = new Step {
    glob = List("**/*.md", "**/*.markdown")
    check_diff = "for file in {{ files }}; do mktoc \"$file\" >/dev/null; done"
    fix = "for file in {{ files }}; do mktoc \"$file\" >/dev/null; done"
  }
  ["shellcheck"] = Builtins.shellcheck
  ["shfmt"] = Builtins.shfmt
  ["tombi_format"] = Builtins.tombi_format
  ["tombi"] = (Builtins.tombi) {
    exclude = List("**/mise.toml")
  }
  ["mdbook-lint"] = new Step {
    glob = List("docs/src/**/*.md")
    check_diff = "mdbook-lint lint --config .mdbook-lint.toml {{ files }}"
    fix = "mdbook-lint fix --config .mdbook-lint.toml {{ files }}"
  }
  ["typos"] = Builtins.typos
  ["trailing-whitespace"] = Builtins.trailing_whitespace
}

default_branch = "dev"
exclude = List("**/mermaid.min.js", "**/.opencode/*")
fail_fast = false

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["commit-msg"] {
    steps = new Mapping<String, Step> {
      ["commit_message_format"] = commit_message_validation
      ["cocogitto_commit_msg"] = cocogitto_commit_message
      ["harper_commit_message"] = harper_commit_message
      ["commit_message_beads"] = commit_message_beads
      ["commit_message_length"] = commit_message_length
      ["commit_message_scope"] = commit_message_scope
    }
  }
  ["check"] {
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
}
