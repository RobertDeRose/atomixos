{% if version.tag -%}
## {{ version.tag }} — {{ date | date(format="%Y-%m-%d") }}
{% else -%}
## Unreleased
{% endif -%}

{#- Before v1.0.0 every release may break, so breaking commits stay in their type groups unlabeled. -#}
{% set pre_v1 = not version.tag or version.tag is starting_with("v0.") -%}
{% if pre_v1 -%}
{% set breaking = [] -%}
{% set regular = commits -%}
{% else -%}
{% set breaking = commits | filter(attribute="breaking_change", value=true) -%}
{% set regular = commits | filter(attribute="breaking_change", value=false) -%}
{% endif -%}

{% if breaking | length > 0 -%}
### Breaking changes

{% for commit in breaking -%}
- **BREAKING** {% if commit.scope %}**{{ commit.scope }}:** {% endif %}{{ commit.summary | upper_first }} (`{{ commit.id | truncate(length=7, end="") }}`)
{% endfor %}
{% endif -%}

{% for value in regular | group_by_type -%}
### {{ value.0 }}

{% for commit in value.1 -%}
- {% if commit.scope %}**{{ commit.scope }}:** {% endif %}{{ commit.summary | upper_first }} (`{{ commit.id | truncate(length=7, end="") }}`)
{% endfor %}
{% endfor -%}
